# Heurist Mesh X402 Gateway - Environment Configuration

# ==========================================
# Heurist Mesh Backend Configuration
# ==========================================

# URL of the Heurist Mesh API server
MESH_API_URL=https://mesh.heurist.ai

# URL of the Mesh metadata endpoint (provides agent schemas and configurations)
MESH_METADATA_URL=https://mesh.heurist.ai/metadata.json

# API key for authenticating requests to Heurist Mesh
# Obtain from: https://mesh.heurist.ai (contact Heurist team)
MESH_API_KEY=your_mesh_api_key_here

# ==========================================
# X402 Payment Configuration
# ==========================================

# Network for Base X402 payments (this gateway expects 'base')
X402_NETWORK=base

# Default price in USD for tools without specific pricing (e.g., "0.10" = 10 cents)
DEFAULT_PRICE_USD=0.10

# USDC contract address on Base mainnet
# Reference: https://basescan.org/token/0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# USDC contract address on Base Sepolia testnet (for reference; resolved internally by x402 middleware)
# Reference: https://sepolia.basescan.org/token/0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Coinbase CDP API credentials (optional; only needed if using CDP facilitator)
# CDP_API_KEY_ID=your_cdp_api_key_id
# CDP_API_KEY_SECRET=your_cdp_api_key_secret

# ==========================================
# Solana X402 Configuration (optional)
# ==========================================

# If empty, Solana routes are disabled.
X402_SOLANA_TREASURY_ADDRESS=

# Default facilitator for Solana x402 v2.
X402_SOLANA_FACILITATOR_URL=https://facilitator.payai.network

# Optional custom Solana RPC.
X402_SOLANA_RPC_URL=

# ==========================================
# XRPL X402 Configuration
# ==========================================

# Set false to disable XRPL route generation.
X402_XRPL_ENABLED=true

# XRPL CAIP-2 network ID. For the current facilitator, use xrpl:0.
X402_XRPL_NETWORK=xrpl:0

# Required recipient address for XRPL payments.
X402_XRPL_TREASURY_ADDRESS=ra9b6JX5aPVbdJhogDDddsRAcasWg7gzC3

# XRPL facilitator endpoint.
X402_XRPL_FACILITATOR_URL=https://xrpl-facilitator-mainnet.t54.ai

# RLUSD asset symbol (normalized to canonical XRPL currency code at runtime).
X402_XRPL_ASSET=rlusd

# RLUSD issuer on XRPL mainnet.
X402_XRPL_ISSUER=rMxCKbEDwqr76QuheSUMdEGf4B9xJ8m5De

# ==========================================
# MPP Configuration (optional)
# ==========================================

# Set false to disable MPP route generation.
MPP_ENABLED=true

# Secret key used to sign and verify MPP challenges.
MPP_SECRET_KEY=

# Tempo payment recipient for MPP routes.
MPP_TEMPO_RECIPIENT=

# TIP-20 token address accepted by Tempo MPP payments.
# Default is pathUSD on Tempo.
MPP_TEMPO_CURRENCY=0x20c0000000000000000000000000000000000000

# Set true if the server should sponsor Tempo gas fees.
MPP_TEMPO_FEE_PAYER=false

# Set true only when you want to advertise Stripe MPP payments.
MPP_STRIPE_ENABLED=false

# Stripe secret key used by MPP for Shared Payment Token charges.
STRIPE_SECRET_KEY=

# Stripe Business Network profile ID.
MPP_STRIPE_NETWORK_ID=internal

# Comma-separated Stripe payment method types to allow for MPP.
MPP_STRIPE_PAYMENT_METHOD_TYPES=card

# ==========================================
# Server Configuration
# ==========================================

# Port for the Express server to listen on
PORT=3402

# Node environment: 'development' or 'production'
NODE_ENV=development

# Public base URL used in discovery/resource links
BASE_URL=https://mesh.heurist.xyz

# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# ==========================================
# Optional Configuration
# ==========================================

# Maximum request timeout in milliseconds (default: 60000 = 60 seconds)
# REQUEST_TIMEOUT=60000

# Metadata cache TTL in seconds (default: 300 = 5 minutes)
# METADATA_CACHE_TTL=300

# Maximum retries for Mesh API calls (default: 3)
# MESH_API_MAX_RETRIES=3

# Enable CORS (default: true)
# CORS_ENABLED=true

# Allowed origins for CORS (comma-separated, default: *)
# CORS_ORIGINS=https://example.com,https://app.example.com
