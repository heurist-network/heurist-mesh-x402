# Heurist Mesh X402 Gateway - Environment Configuration

# ==========================================
# Heurist Mesh Backend Configuration
# ==========================================

# URL of the Heurist Mesh API server
MESH_API_URL=https://mesh.heurist.ai

# URL of the Mesh metadata endpoint (provides agent schemas and configurations)
MESH_METADATA_URL=https://mesh.heurist.ai/metadata.json

# API key for authenticating requests to Heurist Mesh
# Obtain from: https://mesh.heurist.ai (contact Heurist team)
MESH_API_KEY=your_mesh_api_key_here

# ==========================================
# X402 Payment Configuration
# ==========================================

# Network for X402 payments: 'base-sepolia' for testnet, 'base' for production
X402_NETWORK=base-sepolia

# Default price in USD for tools without specific pricing (e.g., "0.10" = 10 cents)
DEFAULT_PRICE_USD=0.10

# USDC contract address on Base mainnet
# Reference: https://basescan.org/token/0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# USDC contract address on Base Sepolia testnet
# Reference: https://sepolia.basescan.org/token/0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_USDC_ADDRESS_BASE_SEPOLIA=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# ==========================================
# X402 Facilitator Configuration
# ==========================================

# For testnet: Use external facilitator service
# Uncomment for base-sepolia network
X402_FACILITATOR_URL=https://x402.org/facilitator

# For production: Use Coinbase CDP facilitator
# Uncomment for base mainnet and add your CDP API credentials
# CDP_API_KEY_ID=your_cdp_api_key_id
# CDP_API_KEY_SECRET=your_cdp_api_key_secret

# ==========================================
# Server Configuration
# ==========================================

# Port for the Express server to listen on
PORT=3402

# Node environment: 'development' or 'production'
NODE_ENV=development

# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# ==========================================
# Optional Configuration
# ==========================================

# Maximum request timeout in milliseconds (default: 60000 = 60 seconds)
# REQUEST_TIMEOUT=60000

# Metadata cache TTL in seconds (default: 300 = 5 minutes)
# METADATA_CACHE_TTL=300

# Maximum retries for Mesh API calls (default: 3)
# MESH_API_MAX_RETRIES=3

# Enable CORS (default: true)
# CORS_ENABLED=true

# Allowed origins for CORS (comma-separated, default: *)
# CORS_ORIGINS=https://example.com,https://app.example.com
